{
  "name": "hackathon-type-orbit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm test && npm run test:e2e",
    "gemini": "node scripts/gemini.mjs",
    "qa": "npm run workflow:verify && npm run review:pack && node scripts/review.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:live": "node --env-file-if-exists=.env scripts/live-smoke.mjs",
    "practice:start": "node scripts/practice.mjs start",
    "practice:verify": "node scripts/practice.mjs syntax && node --test practice/tests/*.test.js && node scripts/practice.mjs python",
    "practice:e2e": "playwright test --config practice/playwright.config.js",
    "workflow:test": "node --test tests/workflow/*.test.js",
    "workflow:verify": "node scripts/workflow.mjs verify",
    "review:pack": "node scripts/workflow.mjs pack",
    "review:gemini": "node scripts/review.mjs",
    "practice:git": "node scripts/git-lab.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@google/gemini-cli": "0.66.0",
    "@playwright/test": "1.64.1",
    "yaml": "2.9.1"
  }
}
